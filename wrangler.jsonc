{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luminart-kazik",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "kazik.luminart.app", "custom_domain": true }]
}
